{
  "expo": {
    "name": "ShiftUp",
    "description": "ShiftUp: From Grassroots to Greatness",
    "slug": "clubpulse",
    "scheme": "clubpulse",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#04091A",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#04091A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.clubpulse.app",
      "buildNumber": "12",
      "infoPlist": {
        "NSMotionUsageDescription": "ShiftUp uses your phone's motion sensors to count your daily steps and reward you with Scores.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "ShiftUp uses the camera to film your batting or bowling so it can score your technique.",
        "NSMicrophoneUsageDescription": "ShiftUp uses the microphone only if you record a new video with sound to analyse.",
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.clubpulse.app",
      "versionCode": 12,
      "permissions": [
        "ACTIVITY_RECOGNITION",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND",
        "CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1D4ED8"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-sensors",
        {
          "motionPermission": "ShiftUp uses your phone's motion sensors to count your daily steps and reward you with Scores."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#EFC84A"
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "ShiftUp reads your step count from Apple Health, including steps from your watch or other wearables, so you can earn Scores for staying active.",
          "NSHealthUpdateUsageDescription": "ShiftUp does not save anything to Apple Health. It only reads your step count.",
          "background": false
        }
      ],
      "expo-background-task",
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d45db8c3-4bfa-4e3e-a487-c5dd8dc6f75c"
      }
    },
    "owner": "clubpulseadmin"
  }
}
